# One AI provider is required (server-side only — never shipped to the browser).
# If both keys are set, OpenAI is used unless LLM_PROVIDER=gemini.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini          # default; gpt-5-nano is cheaper, gpt-4o-mini is the older cheap one
# OPENAI_REASONING_EFFORT=low      # gpt-5 family only
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview
# LLM_PROVIDER=openai|gemini

# Optional: show the browser while applying (local only; ignored on Vercel).
# HEADLESS=false

# Optional: record a .webm of each apply run to ./recordings (local only).
# RECORD_VIDEO=1

# Optional kill-switch: "true" never actually submits an application.
# APPLY_DRY_RUN=false

# Optional cloud sync (Turso). Leave unset to run on LocalStorage only.
# WARNING: VITE_* vars are inlined into the client bundle and are readable by
# anyone who loads the page. Only use a token you are happy to expose.
# VITE_TURSO_URL=libsql://your-db.turso.io
# VITE_TURSO_TOKEN=
